---
import Layout from '../../layouts/Layout.astro';
import RevealText from '../../components/RevealText.astro';
import projects from '../../data/projets.json';
import ProjectMedia from '../../components/ProjectMedia.astro';
import MainVisual from '../../components/MainVisual.astro';
import type { MediaEntry } from '../../utils/media';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<Layout title={`${project.titre} — Portfolio`}>
  <article class="project-page">
    <div class="project-intro">
      <RevealText as="p" class="project-meta font-mono">
        {project.categorie} — {project.secteur} — {project.annee}
      </RevealText>
      <RevealText as="h1" class="project-title">{project.titre}</RevealText>
      <RevealText as="p" class="project-description">{project.description}</RevealText>
    </div>

    <header class="project-hero">
      <MainVisual main={project.main} class="project-hero-image" data-project-hero />
    </header>

    <div class="project-content">
      {project.images.map((entry: MediaEntry) => (
        <div class="project-extra">
          <ProjectMedia entry={entry} data-reveal-image />
        </div>
      ))}
    </div>

    <div class="project-back-mask">
      <a href="/projets" data-morph-back class="project-back font-mono">← Projets</a>
    </div>
  </article>
</Layout>

<style>
  .project-page {
    position: relative;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .project-intro {
    min-height: 60dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 0 1.5rem;
    max-width: 40rem;
    margin: 0 auto;
  }

  .project-meta {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .project-title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    line-height: 1.05;
  }

  .project-description {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5;
    max-width: 32rem;
    opacity: 0.9;
  }

  .project-hero {
    position: relative;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    /* FIX : Éradique la ligne blanche de rendu sous-pixel */
    margin-top: -1px; 
  }

  .project-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-content {
    max-width: 40rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 8rem;
  }

  .project-extra {
    margin-bottom: 2rem;
  }

  .project-extra :global(img),
  .project-extra :global(video) {
    width: 100%;
    height: auto;
    display: block;
  }

  .project-back-mask {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 20;
    overflow: hidden;
  }

  .project-back {
    display: block;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0.8;
    color: #fff;
    /* No mix-blend-mode over the hero video - see .temp-nav, Layout.astro. */
  }

  .project-back:hover {
    opacity: 1;
  }
</style>