---
import Layout from '../layouts/Layout.astro';
import projects from '../data/projets.json';
---

<Layout title="Projets — Portfolio">
  <div class="projects-page" data-view="carousel">
    <!-- Vue 1: grand carrousel plein écran, un projet à la fois. -->
    <section class="view-carousel">
      <div class="carousel-track">
        {projects.map((project, i) => (
          <div
            class="carousel-item"
            class:list={{ 'is-current': i === 0 }}
            data-name={project.titre}
            data-meta={`${project.categorie} ${project.secteur} (${String(i + 1).padStart(2, '0')})`}
          >
            <a href={`/projets/${project.slug}`} data-morph-source class="morph-link">
              <img src={project.images[0]} alt="" />
            </a>
          </div>
        ))}
      </div>
      <!-- One shared info block, not per-image - it stays put at the
           bottom-left while the images swipe past underneath it, sliding
           itself under its own mask between projects. -->
      <div class="carousel-info item-info">
        <div class="info-content">
          <span class="info-name">{projects[0].titre}</span>
          <span class="info-meta font-mono">
            {projects[0].categorie} {projects[0].secteur} (01)
          </span>
        </div>
      </div>
    </section>

    <!-- Vue 2: carrousel dézoomé, plusieurs projets visibles à la fois. -->
    <section class="view-dezoom" hidden>
      <div class="dezoom-track">
        {projects.map((project, i) => (
          <div class="dezoom-item">
            <div class="item-info">
              <div class="info-content">
                <span class="info-name">{project.titre}</span>
                <span class="info-meta font-mono">
                  {project.categorie} {project.secteur} ({String(i + 1).padStart(2, '0')})
                </span>
              </div>
            </div>
            <a href={`/projets/${project.slug}`} data-morph-source class="morph-link">
              <img src={project.images[0]} alt="" />
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Vue 3: liste, une ligne par projet, défilement vertical normal. -->
    <section class="view-liste" hidden>
      {projects.map((project, i) => (
        <div class="liste-row">
          <div class="item-info">
            <span class="info-name">{project.titre}</span>
            <span class="info-meta font-mono">
              {project.categorie} {project.secteur} ({String(i + 1).padStart(2, '0')})
            </span>
            <!-- Ink curtain over the whole title block - see
                 hideListeTitle/revealListeTitle in projets-page.ts. Same
                 single-curtain, JS-flipped-transform-origin technique as
                 the image curtains below. -->
            <div class="liste-title-curtain" aria-hidden="true"></div>
          </div>
          <a href={`/projets/${project.slug}`} data-morph-source class="liste-images">
            {project.images.slice(0, 4).map((src) => (
              <div class="liste-image">
                <img src={src} alt="" />
                <!-- Solid ink curtain, not a clip-path crop, for perf (see
                     hideListeRow/showListeRow in projets-page.ts) - transform
                     is the only thing animated, so this stays on the
                     compositor instead of the clip-path repaint every frame
                     that made leaving vue3 laggy. One curtain per image (not
                     per row, so each can be staggered slightly behind the
                     last) - its own transform-origin is flipped between
                     'top' and 'bottom' in JS depending on whether it's
                     revealing or hiding, rather than keeping two separate
                     top-/bottom-anchored curtains around. -->
                <div class="liste-image-curtain" aria-hidden="true"></div>
              </div>
            ))}
          </a>
        </div>
      ))}
    </section>

    <!-- Vue 1 <-> Vue 2 morph: a single dedicated image, not part of either
         view, physically resized over the real one during the transition -
         see morphBetweenCarouselAndDezoom in projets-page.ts. -->
    <img class="morph-hero" alt="" aria-hidden="true" hidden />

    <!-- .view-switcher-mask is the mask (fixed, overflow:hidden, no
         padding/background of its own - just the boundary). .view-switcher
         (the whole panel: background, padding, radius, AND the buttons
         together) is what project-morph.ts animates as one unit, sinking
         down through the mask's bottom edge and rising back, same
         technique as #temp-nav above - not just the icons within a static
         panel, the panel goes with them. -->
    <div class="view-switcher-mask">
      <div class="view-switcher" role="tablist" aria-label="Changer de vue">
        <button type="button" class="view-btn" data-set-view="carousel" aria-label="Grand carrousel">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <rect x="4" y="5" width="16" height="14" rx="1" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <button type="button" class="view-btn" data-set-view="dezoom" aria-label="Carrousel dézoomé">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <rect x="2" y="7" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="9" y="7" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="16" y="7" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <button type="button" class="view-btn" data-set-view="liste" aria-label="Liste">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" stroke="currentColor" stroke-width="1.5" />
            <line x1="4" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="1.5" />
            <line x1="4" y1="17" x2="20" y2="17" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style>
  .projects-page {
    min-height: 100dvh;
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .info-name {
    font-size: 1rem;
  }

  .info-meta {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  /* Wraps a single project image (carousel, dezoom) for the project-morph
     transition (see project-morph.ts) without taking part in layout itself
     - its child <img> keeps behaving exactly as if it were still a direct
     child of .carousel-item / .dezoom-item, positioned/sized by their
     existing rules. Vue 3's own link (.liste-images) doesn't use this: it
     needs to actually be a flex container, so it carries that layout
     directly instead of collapsing. */
  .morph-link {
    display: contents;
  }

  /* --- Vue 1: carrousel --- */

  .view-carousel {
    position: fixed;
    inset: 0;
    height: 100dvh;
    overflow: hidden;
  }

  .carousel-track {
    position: relative;
    height: 100%;
  }

  /* Stacked full-bleed layers, not a scrolled track - only the current item
     (and briefly, the incoming one sliding over it) are ever visible. Index
     wraps in plain JS, so looping past the last/first project never has to
     scroll a physical track back across the others. */
  .carousel-item {
    position: absolute;
    inset: 0;
    visibility: hidden;
    transform: translateX(0);
  }

  .carousel-item.is-current {
    visibility: visible;
    z-index: 1;
  }

  .carousel-item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The mask: fixed in place at the bottom-left, clips .info-content as it
     translates through - appearing rises up into view, disappearing sinks
     back down out of it. */
  .carousel-info {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 2;
    overflow: hidden;
  }

  .carousel-info .info-content {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .carousel-info .info-name {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }

  .carousel-info .info-meta {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  /* --- Vue 2: carrousel dézoomé --- */

  .view-dezoom {
    position: fixed;
    inset: 0;
    height: 100dvh;
    overflow: hidden;
  }

  .dezoom-track {
    display: flex;
    align-items: center;
    height: 100%;
    /* max-content, not the block-level default of auto: a flex container
       without it stays constrained to its parent's width even though its
       children overflow that box, which would leave Lenis (given this as
       its "content") measuring the wrong, too-narrow scroll range. */
    width: max-content;
    gap: 0.5rem;
    padding: 0 1rem;
  }

  .dezoom-item {
    flex: 0 0 auto;
    height: 56dvh;
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .dezoom-item img {
    flex: 1;
    width: 100%;
    object-fit: cover;
  }

  /* Same mask/content split as .carousel-info, used only for whichever
     card is selected when morphing to/from vue 1 - the other cards' text
     never animates on its own, it just fades with the rest of their card.
     flex-shrink:0 matters here: overflow:hidden makes a flex item's
     automatic minimum size 0 instead of its content size, so without this
     the sibling img's flex:1 happily squeezed this down to nothing. */
  .dezoom-item .item-info {
    flex-shrink: 0;
    overflow: hidden;
  }

  .dezoom-item .info-content {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  /* --- Vue 3: liste --- */

  .view-liste {
    padding: 7rem 0 4rem;
  }

  .liste-row {
    border-bottom: 1px solid rgba(245, 244, 241, 0.15);
  }

  .liste-row .item-info {
    position: relative;
    padding: 1.5rem 1.5rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    /* The mask - without this, hideInfoParts/revealInfoParts's translateY
       has nothing to clip against, so the "hidden" state is just the text
       sitting there in plain view, shifted down, instead of actually
       hidden - every other masked text on the site (.carousel-info,
       .dezoom-item .item-info) already has this, this one was missed. */
    overflow: hidden;
  }

  /* Covers the whole title block - see hideListeTitle/revealListeTitle in
     projets-page.ts. transform-origin is set from JS right before each
     animation (bottom to hide, top to reveal) rather than keeping two
     separate curtains around. */
  .liste-title-curtain {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    pointer-events: none;
    transform: scaleY(0);
    transform-origin: bottom;
    z-index: 1;
  }

  .liste-row .info-name {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
  }

  .liste-images {
    display: flex;
  }

  /* One wrapper per image (not per row) so each can reveal/hide on its own
     stagger - see LISTE_IMAGE_STAGGER in projets-page.ts, the "in line,
     slightly delayed compared to each other" request. position:relative
     anchors that image's own curtain below to just its own box, not the
     whole row. */
  .liste-image {
    position: relative;
    flex: 1 1 0;
    width: 0;
    height: 22vw;
    border-right: 1px solid var(--color-ink);
  }

  .liste-image:last-child {
    border-right: none;
  }

  .liste-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Solid ink panel, not a clip-path crop - see hideListeRow/showListeRow
     in projets-page.ts for why (perf). Reveals bottom-to-top (shrinks from
     scaleY(1), anchored top, so the remaining cover recedes upward) and
     hides bottom-to-top too (grows to scaleY(1), anchored bottom, so
     coverage advances upward) - JS flips transform-origin between the two
     rather than keeping separate curtains for each direction. */
  .liste-image-curtain {
    position: absolute;
    /* A couple px taller than the image on each edge, not a flush inset:0
       - .liste-row's own border-bottom sits right at the images' bottom
       edge, and a flush curtain left a sub-pixel sliver of it showing
       through (as a thin white line) once scaleY had it mostly covered.
       The overshoot is invisible against the images themselves, well
       inside the border's own thickness. */
    top: -2px;
    right: 0;
    bottom: -2px;
    left: 0;
    background: var(--color-ink);
    pointer-events: none;
    transform: scaleY(0);
    transform-origin: bottom;
    z-index: 1;
  }

  /* Every project has at least 4 images, so capping the markup itself at 4
     (see projets.astro) and only ever hiding down from there guarantees the
     same count for every row at a given width - 2 on mobile, 3 up to
     tablet, 4 above that. */
  @media (max-width: 900px) {
    .liste-image {
      height: 30vw;
    }
    .liste-image:nth-child(n + 4) {
      display: none;
    }
    .dezoom-item {
      height: 46dvh;
    }
  }

  @media (max-width: 600px) {
    .liste-image {
      height: 45vw;
    }
    .liste-image:nth-child(n + 3) {
      display: none;
    }
    .dezoom-item {
      height: 34dvh;
    }
    .dezoom-track {
      gap: 0.35rem;
      padding: 0 0.75rem;
    }
  }

  /* --- View switcher --- */

  .view-switcher-mask {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 20;
    /* The boundary only - no padding/background of its own, so its height
       matches .view-switcher's rendered height (padding included)
       exactly. That's what makes translating .view-switcher down by its
       own full height (project-morph.ts's maskClearDistance) clear the
       mask completely - a mask with its own extra padding left a sliver
       of the panel still peeking out the bottom, the "doesn't fully
       cover" bug. */
    overflow: hidden;
  }

  .view-switcher {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem;
    background: rgba(17, 18, 20, 0.55);
    border-radius: 0.5rem;
  }

  .view-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(245, 244, 241, 0.3);
    background: transparent;
    color: rgba(245, 244, 241, 0.5);
    cursor: pointer;
  }

  .view-btn.is-active {
    color: var(--color-paper);
    border-color: var(--color-paper);
  }

  /* --- Vue 1 <-> Vue 2 morph ---
     One real <img>, physically resized from the outgoing image's on-screen
     rect to the incoming one's (in JS, via morphBetweenCarouselAndDezoom) -
     not the View Transitions API's own old/new screenshot cross-fade. Vue 1
     is full-bleed and vue 2 is a fixed 16:10 card, so object-fit:cover
     crops the same photo differently in each; cross-fading between two
     *different* crops of it read as a visible cut right as the transition
     ended, which is exactly what animating one element's own width/height
     avoids - the browser recomputes its object-fit crop live every frame,
     so it reads as the same photo continuously reframing itself. */
  .morph-hero {
    position: fixed;
    /* Below .view-switcher (20), not above it - the switcher is
       persistent UI chrome and shouldn't get covered by the image while
       it's mid-morph. */
    z-index: 15;
    object-fit: cover;
    pointer-events: none;
    /* FIX TAILWIND RESPONSIVE : empêche l'image de s'écraser */
    max-width: none !important; 
    max-height: none !important;
  }
</style>
