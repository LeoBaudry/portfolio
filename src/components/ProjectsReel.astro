---
import projects from '../data/projets.json';

const featured = projects.slice(0, 5);
---

<section class="projects-reel">
  <div class="reel-sticky">
    <div class="reel-hero" aria-hidden="true">
      <img src="/images/hero.jpg" alt="" class="reel-hero-image" />
    </div>

    <div class="reel-hero-fade" aria-hidden="true"></div>

    <div class="reel-scroll-hint" aria-hidden="true">
      <span class="font-mono">Défiler</span>
      <span class="reel-scroll-line"></span>
    </div>

    <div class="reel-intro-text">
      <p class="reel-intro-body">
        Designer et développeur, je construis des interfaces où le mouvement a un sens et
        sert la lecture plutôt que de la distraire.
      </p>
    </div>

    {featured.map((project, i) => (
      <div class="reel-project" data-index={i}>
        <a href={`/projets/${project.slug}`} data-morph-source class="morph-link">
          <img src={project.images[0]} alt="" class="reel-image" />
        </a>
        <div class="reel-overlay" aria-hidden="true"></div>
        <div class="reel-bars" aria-hidden="true"></div>
        <div class="reel-info">
          <p class="reel-category font-mono">{project.categorie}</p>
          <h3 class="reel-title">{project.titre}</h3>
          <p class="reel-year font-mono">{project.annee}</p>
        </div>
      </div>
    ))}

    <div class="reel-grid-lines" aria-hidden="true"></div>

    <div class="reel-counter font-mono" aria-hidden="true">
      <span class="reel-counter-current">1</span> / <span>{featured.length}</span>
    </div>
  </div>

  <div class="reel-cursor" aria-hidden="true">
    <svg viewBox="0 0 40 40" class="reel-cursor-ring">
      <circle cx="20" cy="20" r="18" class="reel-cursor-track" />
      <circle
        cx="20"
        cy="20"
        r="18"
        class="reel-cursor-progress"
        stroke-dasharray="113.097"
        stroke-dashoffset="113.097"
      />
    </svg>
  </div>
</section>

<style>
  .projects-reel {
    position: relative;
  }

  .reel-sticky {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-ink);
    /* Single source of truth for column count - inherited by both the
       curtain bars (.reel-project) and the grid lines, so they always
       match at every breakpoint. */
    --cols: 5;
  }

  @media (max-width: 900px) {
    .reel-sticky {
      --cols: 3;
    }
  }

  @media (max-width: 600px) {
    .reel-sticky {
      --cols: 2;
    }
  }

  /* Layer order (back to front): hero image -> dark fade -> project
     panels (bars start closed, so they read as a continuation of the dark
     fade until the intro curtain opens) -> intro copy -> grid lines -> info. */

  .reel-hero {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .reel-hero-image {
    position: absolute;
    left: 0;
    top: -15%;
    width: 100%;
    height: 130%;
    object-fit: cover;
    will-change: transform;
  }

  .reel-hero-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }

  .reel-scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-paper);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reel-scroll-line {
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    opacity: 0.6;
  }

  .reel-intro-text {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  .reel-intro-body {
    max-width: 40rem;
    margin: 0;
    text-align: center;
    color: var(--color-paper);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.4;
    opacity: 0;
  }

  .reel-grid-lines {
    position: absolute;
    inset: 0;
    display: flex;
    z-index: 5;
    pointer-events: none;
  }

  /* Built dynamically in projects-reel.ts (so the count can track --cols
     and be rebuilt on resize) - :global() because Astro's scoped-CSS
     attribute is only applied to elements present at build time, not ones
     created later via document.createElement. */
  .reel-grid-lines :global(.reel-gridline) {
    flex: 1;
    border-right: 1px solid rgba(245, 244, 241, 0.25);
    transform: scaleY(0);
    transform-origin: bottom;
  }

  .reel-grid-lines :global(.reel-gridline:last-child) {
    border-right: none;
  }

  .reel-project {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
  }

  /* Wraps .reel-image for the project-morph transition (see
     project-morph.ts) without taking part in layout - same technique as
     projets.astro's .morph-link. */
  .morph-link {
    display: contents;
  }

  .reel-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reel-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Purely decorative - must not block clicks through to .reel-image's
       link underneath it. */
    pointer-events: none;
  }

  .reel-bars {
    position: absolute;
    inset: 0;
    display: flex;
    pointer-events: none;
    z-index: 2;
  }

  .reel-bars :global(.reel-bar) {
    flex: 1;
    background: var(--color-ink);
    margin-right: -1px;
    will-change: transform;
  }

  .reel-info {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 6;
    color: var(--color-paper);
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .reel-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    margin: 0;
  }

  .reel-category,
  .reel-year {
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .reel-counter {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 6;
    color: var(--color-paper);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .reel-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    pointer-events: none;
    z-index: 10;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .reel-cursor.is-active {
    opacity: 1;
  }

  .reel-cursor.is-fixed-position {
    top: auto;
    left: auto;
    bottom: 1.5rem;
    right: 1.5rem;
    margin: 0;
    transform: none !important;
  }

  .reel-cursor-ring {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .reel-cursor-track {
    fill: none;
    stroke: color-mix(in srgb, var(--color-paper) 30%, transparent);
    stroke-width: 2;
  }

  .reel-cursor-progress {
    fill: none;
    stroke: var(--color-paper);
    stroke-width: 2;
    stroke-linecap: round;
  }
</style>
