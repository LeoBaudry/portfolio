---
import projects from '../data/projets.json';
import ProjectImage from './ProjectImage.astro';
import MainVisual from './MainVisual.astro';

const featured = projects.slice(0, 5);
---

<section class="projects-reel">
  <div class="reel-sticky">
    <div class="reel-hero" aria-hidden="true">
      <ProjectImage src="/images/hero.jpg" role="morph" class="reel-hero-image" />
    </div>

    <div class="reel-hero-fade" aria-hidden="true"></div>

    <div class="reel-scroll-hint" aria-hidden="true">
      <span class="font-mono">Défiler</span>
      <span class="reel-scroll-line"></span>
    </div>

    <div class="reel-intro-text">
      <p class="reel-intro-body">
        Designer et développeur, je construis des interfaces où le mouvement a un sens et
        sert la lecture plutôt que de la distraire.
      </p>
    </div>

    {featured.map((project, i) => (
      <div class="reel-project" data-index={i}>
        <a href={`/projets/${project.slug}`} data-morph-source class="morph-link">
          <MainVisual main={project.main} class="reel-image" mobileVideo={false} />
        </a>
        <div class="reel-overlay" aria-hidden="true"></div>
        <div class="reel-bars" aria-hidden="true"></div>
        <div class="reel-info">
          <!-- Each line is its own mask: .reel-line slides inside it
               (projects-reel.ts hide/revealInfoLines). -->
          <p class="reel-category font-mono"><span class="reel-line">{project.categorie}</span></p>
          <h3 class="reel-title"><span class="reel-line">{project.titre}</span></h3>
          <p class="reel-year font-mono"><span class="reel-line">{project.annee}</span></p>
        </div>
      </div>
    ))}

    <div class="reel-grid-lines" aria-hidden="true"></div>

    <!-- Its own mask, like the project text: .reel-line slides inside. -->
    <div class="reel-counter font-mono" aria-hidden="true">
      <span class="reel-line"><span class="reel-counter-current">1</span> / <span>{featured.length}</span></span>
    </div>
  </div>

  <!-- Follows the pointer; on touch (no pointer) it sits fixed at the bottom
       centre instead. The fill layer is a copy of the label in inverted
       colours, uncovered left to right as the scroll moves on to the next
       project - projects-reel.ts setProgress. -->
  <div class="reel-cursor" aria-hidden="true">
    <div class="reel-cursor-pill font-mono">
      <span class="reel-cursor-mask"><span class="reel-cursor-text">Voir le projet</span></span>
      <span class="reel-cursor-fill">
        <span class="reel-cursor-mask"><span class="reel-cursor-text">Voir le projet</span></span>
      </span>
    </div>
  </div>
</section>

<style>
  .projects-reel {
    position: relative;
  }

  /* !important on the size: while pinned, ScrollTrigger inlines a px
     width/height measured at its last refresh - after a zoom-out the
     viewport grows instantly but that refresh waits for the resize to
     settle, showing the page background around a too-small reel until it
     does. The viewport units track the new size immediately. */
  .reel-sticky {
    position: relative;
    width: 100vw !important;
    height: 100dvh !important;
    max-width: none !important;
    max-height: none !important;
    overflow: hidden;
    background: var(--color-bg);
    /* Single source of truth for column count - inherited by both the
       curtain bars (.reel-project) and the grid lines, so they always
       match at every breakpoint. */
    --cols: 5;
  }

  @media (max-width: 900px) {
    .reel-sticky {
      --cols: 3;
    }
  }

  @media (max-width: 600px) {
    .reel-sticky {
      --cols: 2;
    }
  }

  /* Layer order (back to front): hero image -> dark fade -> project
     panels (bars start closed, so they read as a continuation of the dark
     fade until the intro curtain opens) -> intro copy -> grid lines -> info. */

  .reel-hero {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .reel-hero-image {
    position: absolute;
    left: 0;
    top: -15%;
    width: 100%;
    height: 130%;
    object-fit: cover;
    will-change: transform;
  }

  .reel-hero-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--color-bg);
    opacity: 0;
    pointer-events: none;
  }

  .reel-scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 2rem;
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reel-scroll-line {
    width: 1px;
    height: 2.5rem;
    background: currentColor;
    opacity: 0.6;
  }

  .reel-intro-text {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  .reel-intro-body {
    max-width: 40rem;
    margin: 0;
    text-align: center;
    color: var(--color-text);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.4;
    /* Each line (split + masked individually by projects-reel.ts, see its
       SplitText call) carries its own hidden state once split - this just
       hides the raw, not-yet-split paragraph for the brief window before
       that JS runs, so there's no flash of unmasked full-size text. Cleared
       in SplitText's onSplit callback. */
    visibility: hidden;
    /* Deliberately NOT pointer-events:auto here (stays inherited none from
       .reel-intro-text) - this container's own box stays full-size even
       while its lines are masked away, and project 0 renders directly
       behind it. Selection is opted back in per-line below instead, since
       a line outside its own mask's visible region isn't hit-tested at all
       - selectable only while actually visible, click-through the rest of
       the time (including onto project 0). */
  }

  /* projects-reel.ts splits this into per-line masks at runtime (SplitText)
     - :global() because Astro's scoped-CSS attribute only applies to
       markup present at build time, not elements created later via JS. */
  :global(.reel-intro-line) {
    pointer-events: auto;
  }

  .reel-grid-lines {
    position: absolute;
    inset: 0;
    display: flex;
    z-index: 5;
    pointer-events: none;
  }

  /* Built dynamically in projects-reel.ts (so the count can track --cols
     and be rebuilt on resize) - :global() because Astro's scoped-CSS
     attribute is only applied to elements present at build time, not ones
     created later via document.createElement. */
  .reel-grid-lines :global(.reel-gridline) {
    flex: 1;
    border-right: 1.5px solid color-mix(in srgb, var(--color-line) 25%, transparent);
    transform: scaleY(0);
    transform-origin: bottom;
  }

  .reel-grid-lines :global(.reel-gridline:last-child) {
    border-right: none;
  }

  .reel-project {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
  }

  /* Wraps .reel-image for the project-morph transition (see
     project-morph.ts) without taking part in layout - same technique as
     projets.astro's .morph-link. */
  .morph-link {
    display: contents;
  }

  .reel-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reel-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Purely decorative - must not block clicks through to .reel-image's
       link underneath it. */
    pointer-events: none;
  }

  .reel-bars {
    position: absolute;
    inset: 0;
    display: flex;
    pointer-events: none;
    z-index: 2;
  }

  .reel-bars :global(.reel-bar) {
    flex: 1;
    background: var(--color-curtain);
    margin-right: -1px;
    will-change: transform;
  }

  /* Project text on the reel's grid: one element per column (--cols, the
     same columns as the grid lines), each starting just right of its line.
     Vertically centred on the screen at every size.
     Wide: category | title | year | - | counter, one row.
     2-3 columns: no room for a row - the project stacks in column 1, the
     counter keeps the last column. */
  .reel-sticky {
    --col-pad: 1.25rem;
    --reel-title-size: clamp(2.25rem, 3.6vw, 4rem);
    --reel-small-size: 0.95rem;
    /* The row's bottom edge, placing the title's line box (line-height
       1.1) exactly on the middle of the screen - a bottom rather than a
       translate(-50%) so the counter below can share the same baseline. */
    --row-bottom: calc(50% - 0.55 * var(--reel-title-size));
  }

  .reel-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--row-bottom);
    z-index: 6;
    color: var(--color-text);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    align-items: last baseline;
  }

  /* Sized to their text, not to the column - a title wider than its
     column runs on over the next one instead of its mask clipping it. */
  .reel-info > * {
    justify-self: start;
    padding-left: var(--col-pad);
    white-space: nowrap;
  }

  .reel-category {
    grid-column: 1;
  }

  .reel-title {
    grid-column: 2;
    font-size: var(--reel-title-size);
    line-height: 1.1;
    margin: 0;
  }

  .reel-year {
    grid-column: 3;
  }

  /* The masks: fixed boundaries the .reel-line inside sinks under / rises
     out of - same technique as the /projets info masks. */
  .reel-category,
  .reel-title,
  .reel-year {
    overflow: hidden;
  }

  .reel-line {
    display: block;
  }

  .reel-category,
  .reel-year {
    font-size: var(--reel-small-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  /* Last column. Not in .reel-info's grid (one counter for all projects),
     so its baseline is lined up by hand with the row's: the title's box
     reaches ~0.25em of its own size below the baseline, a small line's
     ~0.3em of its own. */
  .reel-counter {
    position: absolute;
    left: calc(100% / var(--cols) * (var(--cols) - 1));
    bottom: calc(var(--row-bottom) + 0.25 * var(--reel-title-size) - 0.3em);
    padding-left: var(--col-pad);
    z-index: 6;
    overflow: hidden;
    color: var(--color-text);
    font-size: var(--reel-small-size);
    letter-spacing: 0.06em;
  }

  @media (max-width: 900px) {
    .reel-sticky {
      --reel-title-size: clamp(1.75rem, 7vw, 2.75rem);
      --reel-small-size: 0.8rem;
    }

    /* The stack and the counter each centred on the middle. */
    .reel-info {
      right: auto;
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }

    .reel-counter {
      bottom: auto;
      top: 50%;
      translate: 0 -50%;
    }
  }

  /* Positioned by projects-reel.ts (translate to the lagged pointer); the
     pill sits just below-right of the pointer, never under it. Shown /
     hidden only by transform (pill scale + text masks), no opacity. */
  .reel-cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 10;
  }

  .reel-cursor-pill {
    position: relative;
    display: block;
    margin: 14px 0 0 14px;
    padding: 0.95em 1.6em;
    border-radius: 5px;
    overflow: hidden;
    /* Frosted: see-through with a light blur of what's behind. */
    background: color-mix(in srgb, var(--color-bg) 45%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    font-size: 0.7rem;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: scale(0);
    transform-origin: top left;
  }

  /* Inverted copy on top, uncovered left to right. clip-path on purpose:
     a pill-sized box repaints nothing worth measuring (unlike the images,
     where it lagged), and the two labels have to line up exactly. */
  .reel-cursor-fill {
    position: absolute;
    inset: 0;
    padding: inherit;
    background: color-mix(in srgb, var(--color-text) 85%, transparent);
    color: var(--color-bg);
    clip-path: inset(0 100% 0 0);
  }

  .reel-cursor-mask {
    display: block;
    overflow: hidden;
    /* Room for descenders inside the mask at line-height 1. */
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .reel-cursor-text {
    display: block;
    transform: translateY(110%);
  }

  /* Touch: no pointer to follow - the pill takes the bottom centre. */
  @media not all and (pointer: fine) {
    .reel-cursor {
      top: auto;
      left: 50%;
      bottom: 1.5rem;
      translate: -50% 0;
    }

    .reel-cursor-pill {
      margin: 0;
      transform-origin: center bottom;
    }
  }
</style>
