---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import logoSvg from '../assets/logo.svg?raw';
import loaderScript from '../scripts/site-loader-inline.js?raw';

interface Props {
  title?: string;
}

const { title = 'Portfolio' } = Astro.props;

// Site-entry loader geometry, computed here at build time so the logo's
// masks exist in the HTML and its strokes can animate (pure CSS) from the
// first paint, long before any JS has downloaded. See
// site-loader-inline.js for what drives the count, line, grid and exit.
//
// The logo's two angles (measured from logo.svg's first stroke): AXIS is
// the strokes' long diagonal - each slides along it, in and out of a mask
// cut to its own shape. Assumes logo.svg's paths use absolute coordinates
// only (as Figma exports them).
const unit = (x: number, y: number) => {
  const len = Math.hypot(x, y);
  return { x: x / len, y: y / len };
};
const AXIS = unit(37, -55);
const r2 = (n: number) => Math.round(n * 100) / 100;

const logoViewBox = logoSvg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 70 71';
const logoStrokes = [...logoSvg.matchAll(/\sd="([^"]+)"/g)].map(([, d]) => {
  const nums = (d.match(/-?\d*\.?\d+(?:e-?\d+)?/gi) ?? []).map(Number);
  let min = Infinity, max = -Infinity;
  for (let i = 0; i + 1 < nums.length; i += 2) {
    const along = nums[i] * AXIS.x + nums[i + 1] * AXIS.y;
    min = Math.min(min, along);
    max = Math.max(max, along);
  }
  // +2: 1-unit margin each end so antialiased edges are never clipped.
  const travel = max - min + 2;
  return { d, travel: { x: r2(AXIS.x * travel), y: r2(AXIS.y * travel) } };
});

// The homepage reel's column count (5 / 3 / 2, see ProjectsReel.astro) -
// all 5 columns/lines are rendered, CSS hides the extra ones per breakpoint.
const LOADER_COLS = 5;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <noscript><style>.site-loader { display: none; }</style></noscript>
  </head>
  <!--
    transition:animate="none" on body: Astro's ClientRouter otherwise plays
    its own default crossfade on every element via the native View
    Transition API's ::view-transition-old/new pseudo-elements, INCLUDING
    persisted ones (transition:persist keeps the DOM node continuous, but
    the browser still renders a default fade of its own on top of it unless
    told not to). That native fade running at the same time as GSAP driving
    the same nodes in page-transitions.ts is what produced the tearing/
    "two different elements" look last time - every element GSAP touches
    during the transition needs its own transition:animate="none" too.
  -->
  <body transition:animate="none">
    <!--
      Temporary nav, until the real one is designed. #temp-nav itself is the
      mask (overflow:hidden, auto-sized to .temp-nav-inner's own height) -
      project-morph.ts's chrome hide/reveal (see project-morph.ts) animates
      .temp-nav-inner's own translateY within it, sinking it down out of
      view through the mask's bottom edge and rising back the same way,
      rather than sliding the whole nav off past the viewport - the same
      "content moves, mask stays put" technique as the info-text mask
      elsewhere on the site (see hideInfoParts/revealInfoParts in
      projets-page.ts).
    -->
    <nav class="temp-nav" id="temp-nav" transition:persist transition:animate="none">
      <div class="temp-nav-inner">
        <a href="/">Index</a>
        <a href="/projets">Projets</a>
      </div>
    </nav>

    <!--
      Persisted across every navigation (content.md §8's "reveal par le
      bas"): a single fixed panel that both covers the outgoing page and
      uncovers the incoming one, driven entirely by page-transitions.ts via
      astro:before-preparation / astro:after-swap / astro:page-load. Its
      transform is 100% GSAP-owned (see page-transitions.ts) - it must never
      get a CSS transform of its own, GSAP's yPercent stacks on top of
      rather than replacing one.
    -->
    <!--
      Site-entry loader. The markup (logo masks included) is complete in the
      HTML and the strokes slide in with a CSS animation, so it's alive from
      the first paint; the inline script right below it runs everything else
      (count, line, grid, orange, column exit) while the page's JS bundle is
      still downloading; site-loader.ts only inits the page as the columns
      start clearing. Stacking, back to front: columns (the background, each
      with its orange fill) -> bottom line -> grid lines -> logo + count. Persisted and only ever
      hidden after it plays, never removed - see site-loader.ts.
    -->
    <div
      id="site-loader"
      class="site-loader"
      role="progressbar"
      aria-label="Loading"
      aria-busy="true"
      data-sim={import.meta.env.DEV ? '' : undefined}
      transition:persist="site-loader"
      transition:animate="none"
    >
      <div class="site-loader-cols" aria-hidden="true">
        {Array.from({ length: LOADER_COLS }, () => (
          <span class="site-loader-col"><span class="site-loader-col-fill" /></span>
        ))}
      </div>
      <div class="site-loader-logo">
        <svg viewBox={logoViewBox} aria-hidden="true">
          <defs>
            {logoStrokes.map((stroke, i) => (
              <clipPath id={`site-loader-mask-${i}`}><path d={stroke.d} /></clipPath>
            ))}
          </defs>
          {logoStrokes.map((stroke, i) => (
            <g clip-path={`url(#site-loader-mask-${i})`}>
              <g
                class="site-loader-stroke"
                style={`--i: ${i}; --from-x: ${-stroke.travel.x}px; --from-y: ${-stroke.travel.y}px`}
                data-out={`${stroke.travel.x} ${stroke.travel.y}`}
              >
                <path d={stroke.d} />
              </g>
            </g>
          ))}
        </svg>
      </div>
      <div class="site-loader-bar" aria-hidden="true"></div>
      <div class="site-loader-grid" aria-hidden="true">
        {Array.from({ length: LOADER_COLS }, () => <span class="site-loader-gridline" />)}
      </div>
      <div class="site-loader-count" aria-hidden="true">
        {['0', '0', '1'].map((d, i) => (
          <span class:list={['site-loader-digit', { 'is-leading': i < 2 }]}><span>{d}</span></span>
        ))}
      </div>
    </div>
    <script is:inline set:html={loaderScript} />

    <div id="page-wipe" class="page-wipe" aria-hidden="true" transition:persist transition:animate="none"></div>

    <!--
      Persisted clone used only for the project-card -> project-page morph
      (see project-morph.ts). Positioned via top/left/width/height, not
      transform - it has no position:fixed descendants of its own to worry
      about, but staying off transform keeps it consistent with #page-wipe's
      rule and avoids the same stacking trap if it's ever animated further.
    -->
    <img
      id="project-morph-clone"
      class="project-morph-clone"
      alt=""
      aria-hidden="true"
      transition:persist
      transition:animate="none"
    />
    <!-- Carries a main-visual video that keeps playing through a morph
         (main-video.ts liftVideo/landVideo), animated alongside the clone.
         Persisted so the video survives the page swap. -->
    <div id="morph-video-host" class="morph-video-host" transition:persist transition:animate="none"></div>

    <div id="transition-root" class="transition-root" transition:animate="none">
      <slot />
    </div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  .temp-nav {
    position: fixed;
    top: 1.25rem;
    right: 1.5rem;
    z-index: 100;
    /* The mask - no explicit height, so it auto-sizes to .temp-nav-inner's
       own (untransformed) height, same as .carousel-info elsewhere. */
    overflow: hidden;
    mix-blend-mode: difference;
  }

  .temp-nav-inner {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .temp-nav a {
    color: #fff;
    text-decoration: none;
  }

  .temp-nav a:hover {
    text-decoration: underline;
  }

  .page-wipe {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--color-ink);
    pointer-events: none;
    /* No transform here - page-transitions.ts owns it entirely via GSAP's
       yPercent. A CSS transform here doesn't get folded into that; GSAP
       stacks its own translate on top of the computed one instead of
       replacing it, so the element ends up offset by both at once and
       never actually reaches "covering the viewport". */
  }

  .transition-root {
    position: relative;
  }

  .project-morph-clone {
    display: none;
    position: fixed;
    z-index: 210;
    object-fit: cover;
    pointer-events: none;
  }

  /* z-index set per flight: just above whichever clone it travels with. */
  .morph-video-host {
    display: none;
    position: fixed;
    overflow: hidden;
    pointer-events: none;
  }
</style>
