---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { GRID_COLS, logoStrokes, logoViewBox } from '../utils/logo';
import loaderScript from '../scripts/loader/loader-inline.js?raw';
import Menu from '../components/menu/Menu.astro';
import PageTransition from '../components/transitions/PageTransition.astro';

interface Props {
  title?: string;
  // Shown in the middle of the menu bar (ACCUEIL, PROJETS, a project's name).
  pageName: string;
}

const { title = 'Portfolio', pageName } = Astro.props;
const menuPosition = Astro.url.pathname === '/' ? 'top' : 'bottom';

// Site-entry loader: the logo's stroke geometry is shared with the page
// transition (utils/logo.ts), computed at build time so the masks exist in
// the HTML and the strokes can animate (pure CSS) from the first paint.
// See loader/loader-inline.js for what drives the count, line, grid and
// exit.
const LOADER_COLS = GRID_COLS;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <noscript>
      <style>
        .site-loader { display: none; }
        .site-menu { clip-path: none !important; }
        .site-menu-logo, .site-menu-name, .site-menu-toggle { transform: none !important; }
        .site-menu-close { display: none !important; }
      </style>
    </noscript>
  </head>
  <!--
    transition:animate="none" on body: Astro's ClientRouter otherwise plays
    its own default crossfade on every element via the native View
    Transition API's ::view-transition-old/new pseudo-elements, INCLUDING
    persisted ones (transition:persist keeps the DOM node continuous, but
    the browser still renders a default fade of its own on top of it unless
    told not to). That native fade running at the same time as GSAP driving
    the same nodes in transitions/page-wipe.ts is what produced the tearing/
    "two different elements" look last time - every element GSAP touches
    during the transition needs its own transition:animate="none" too.
  -->
  <body transition:animate="none">
    <Menu pageName={pageName} position={menuPosition} />

    <!--
      Site-entry loader. The markup (logo masks included) is complete in the
      HTML and the strokes slide in with a CSS animation, so it's alive from
      the first paint; the inline script right below it runs everything else
      (count, line, grid, orange, column exit) while the page's JS bundle is
      still downloading; loader/loader.ts only inits the page as the columns
      start clearing. Stacking, back to front: columns (the background, each
      with its orange fill) -> bottom line -> grid lines -> logo + count. Persisted and only ever
      hidden after it plays, never removed - see loader/loader.ts.
    -->
    <div
      id="site-loader"
      class="site-loader"
      role="progressbar"
      aria-label="Loading"
      aria-busy="true"
      data-sim={import.meta.env.DEV ? '' : undefined}
      transition:persist="site-loader"
      transition:animate="none"
    >
      <div class="site-loader-cols" aria-hidden="true">
        {Array.from({ length: LOADER_COLS }, () => (
          <span class="site-loader-col"><span class="site-loader-col-fill" /></span>
        ))}
      </div>
      <div class="site-loader-logo">
        <svg viewBox={logoViewBox} aria-hidden="true">
          <defs>
            {logoStrokes.map((stroke, i) => (
              <clipPath id={`site-loader-mask-${i}`}><path d={stroke.d} /></clipPath>
            ))}
          </defs>
          {logoStrokes.map((stroke, i) => (
            <g clip-path={`url(#site-loader-mask-${i})`}>
              <g
                class="site-loader-stroke"
                style={`--i: ${i}; --from-x: ${-stroke.travel.x}px; --from-y: ${-stroke.travel.y}px`}
                data-out={`${stroke.travel.x} ${stroke.travel.y}`}
              >
                <path d={stroke.d} />
              </g>
            </g>
          ))}
        </svg>
      </div>
      <div class="site-loader-bar" aria-hidden="true"></div>
      <div class="site-loader-grid" aria-hidden="true">
        {Array.from({ length: LOADER_COLS }, () => <span class="site-loader-gridline" />)}
      </div>
      <div class="site-loader-count" aria-hidden="true">
        {['0', '0', '1'].map((d, i) => (
          <span class:list={['site-loader-digit', { 'is-leading': i < 2 }]}><span>{d}</span></span>
        ))}
      </div>
    </div>
    <script is:inline set:html={loaderScript} />

    <PageTransition />

    <!--
      Persisted clone used only for the project-card -> project-page morph
      (see transitions/morph.ts). Positioned via top/left/width/height, not
      transform - it has no position:fixed descendants of its own to worry
      about, and staying off transform avoids GSAP stacking its own
      translate on a CSS one if it's ever animated further.
    -->
    <img
      id="project-morph-clone"
      class="project-morph-clone"
      alt=""
      aria-hidden="true"
      transition:persist
      transition:animate="none"
    />
    <!-- Carries a main-visual video that keeps playing through a morph
         (media/video.ts liftVideo/landVideo), animated alongside the clone.
         Persisted so the video survives the page swap. -->
    <div id="morph-video-host" class="morph-video-host" transition:persist transition:animate="none"></div>

    <div id="transition-root" class="transition-root" data-page-name={pageName} transition:animate="none">
      <slot />
    </div>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  /* No background: every section sets its own, and whatever the page
     transition's parallax uncovers must show body's dark (global.css). A
     light background here showed as a white strip under the homepage's
     pinned reel as it drifted up (Leo, 2026-09-27). */
  .transition-root {
    position: relative;
  }

  .project-morph-clone {
    display: none;
    position: fixed;
    z-index: 210;
    object-fit: cover;
    pointer-events: none;
  }

  /* z-index set per flight: just above whichever clone it travels with. */
  .morph-video-host {
    display: none;
    position: fixed;
    overflow: hidden;
    pointer-events: none;
  }
</style>
